{
  "name": "recruithelper-client",
  "version": "3.32.0",
  "private": true,
  "author": "aliyutaozi",
  "description": "AI增员助手客户端外壳(Electron):启停 Go 脑服务 + 加载 UI。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "test:node": "node test/service.test.mjs && node test/layout.test.mjs && node test/pluginSeed.test.mjs && node test/tipSeed.test.mjs && node test/logRotate.test.mjs && node test/overlay.test.mjs && node test/windowSize.test.mjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aliyutaozi.recruithelper",
    "productName": "RecruitHelper",
    "directories": {
      "output": "../../release"
    },
    "files": [
      "*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../build/stage/brain",
        "to": "brain"
      },
      {
        "from": "../ui/dist",
        "to": "ui"
      },
      {
        "from": "../../plugin/dist",
        "to": "plugin"
      },
      {
        "from": "../../third_party/tip",
        "to": "tip"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  }
}
