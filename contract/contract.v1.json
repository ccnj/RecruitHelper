{
  "$comment": "脑手协议契约 v1 机器可读源。唯一规范源是同目录《协议规格-v1.md》,本文件是 codegen 输入。2026-07-17 首个客户安装前按本地可信威胁模型删除配对/auth/issued,自此继续 additive-only。batch: M1=里程碑1激活 / S=感知批次 / X=首个外部副作用原语批次 / far=远期占位。",
  "proto": 1,
  "transport": {
    "scheme": "ws",
    "host": "127.0.0.1",
    "portDefault": 17872,
    "path": "/v1/channel",
    "originPrefix": "chrome-extension://",
    "chromeMin": 116,
    "frame": "一帧一条 JSON 消息,UTF-8 文本帧"
  },
  "envelope": {
    "fields": {
      "proto": { "type": "int", "note": "协议主版本;主版本内 must-ignore 未知字段" },
      "kind": { "type": "string", "enumRef": "kinds" },
      "msgId": { "type": "string", "note": "唯一不透明串(建议 ULID);重传不变;接收方不得解析内容" },
      "session": { "type": "string|null", "note": "welcome 分配;hello/welcome/bye 为 null;cmd 仅受理时刻校验当前会话(已 accepted 的命令跨会话继续执行);重传跨会话时更新为手当前会话" },
      "ts": { "type": "int64", "note": "毫秒;仅诊断;禁止用于去重/排序/裁决" },
      "attempt": { "type": "int", "note": ">=1;仅诊断" },
      "body": { "type": "object" }
    },
    "correlationField": { "name": "ref", "nullable": false, "note": "所有指向另一条消息的字段唯一合法名;codegen 生成为非可空" }
  },
  "compatibility": {
    "unknownFields": "must-ignore",
    "contractHash": "warn-only",
    "schemaEvolution": "additive-only",
    "jsonInteger": "safe-int53"
  },
  "features": {
    "progress/1": { "batch": "S", "note": "长命令过程提示;stage 仅人读;合法 progress 刷新 lastSeen" },
    "lease/1": { "batch": "S", "note": "ack(accepted) 到达脑时启动;合法 progress 按脑接收时刻续租;绝不越过绝对 deadline" },
    "cancel/1": { "batch": "S", "note": "尽力取消;ack 只确认取消请求已收妥;目标 cmd 的 result 永远是终局真相" },
    "blob/1": { "batch": "X", "note": "Claim Check 大载荷;未协商时超限必须响亮失败,禁止截断" }
  },
  "kinds": {
    "hello":    { "dir": "H2B", "ackBy": "welcome|bye", "batch": "M1" },
    "welcome":  { "dir": "B2H", "ackBy": null, "batch": "M1" },
    "bye":      { "dir": "B2H", "ackBy": null, "batch": "M1", "note": "手→脑方向远期预留(优雅下线);v1 手侧终止一律直接关连接" },
    "cmd":      { "dir": "B2H", "ackBy": "ack", "batch": "M1" },
    "ack":      { "dir": "both", "ackBy": null, "batch": "M1" },
    "result":   { "dir": "H2B", "ackBy": "ack", "batch": "M1" },
    "ping":     { "dir": "H2B", "ackBy": "pong", "batch": "M1" },
    "pong":     { "dir": "B2H", "ackBy": null, "batch": "M1" },
    "progress": { "dir": "H2B", "ackBy": null, "lossy": true, "batch": "S" },
    "event":    { "dir": "H2B", "ackBy": null, "lossy": true, "batch": "S", "note": "QoS0 提示;唯一权力=调整巡检开跑时刻/静默窗/健康档" },
    "query":    { "dir": "B2H", "ackBy": "report", "batch": "X" },
    "report":   { "dir": "H2B", "ackBy": null, "batch": "X", "states": ["unknown", "queued", "executing", "attempting", "done"] },
    "cancel":   { "dir": "B2H", "ackBy": "ack", "batch": "S", "note": "尽力而为;ack.ref 指向 cancel 帧,body.ref 指向目标 cmd;与 result 赛跑时 result 赢" }
  },
  "bodies": {
    "hello": { "schema": "HelloBody" },
    "welcome": { "schema": "WelcomeBody" },
    "bye": { "schema": "ByeBody" },
    "cmd": { "schema": "CmdBody" },
    "ack": { "schema": "AckBody" },
    "result": { "schema": "ResultBody" },
    "ping": { "schema": "PingBody" },
    "pong": { "schema": "PongBody" },
    "progress": { "schema": "ProgressBody" },
    "event": { "schema": "EventBody" },
    "query": { "schema": "QueryBody" },
    "report": { "schema": "ReportBody" },
    "cancel": { "schema": "CancelBody" }
  },
  "schemas": {
    "types": {
      "AppInfo": {
        "type": "object",
        "fields": {
          "extVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "browser": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "HelloBody": {
        "type": "object",
        "fields": {
          "handId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "bootId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "protoSupported": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "int", "minimum": 1 } },
          "contractHash": { "type": "string", "minLength": 1, "maxLength": 128 },
          "app": { "ref": "AppInfo" },
          "caps": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "features": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
        }
      },
      "HbParams": {
        "type": "object",
        "fields": {
          "intervalMs": { "type": "int64", "minimum": 1000, "maximum": 120000 },
          "graceMs": { "type": "int64", "minimum": 1000, "maximum": 600000 }
        }
      },
      "Limits": {
        "type": "object",
        "fields": {
          "maxMsgBytes": { "type": "int64", "minimum": 1024, "maximum": 262144 },
          "inlineBytes": { "type": "int64", "minimum": 1024, "maximum": 262144 }
        }
      },
      "SensorParams": {
        "type": "object",
        "fields": {
          "badgeDebounceMs": { "type": "int64", "minimum": 0, "maximum": 3000 },
          "badgeMinEmitIntervalMs": { "type": "int64", "minimum": 1000, "maximum": 60000 },
          "navSettleMs": { "type": "int64", "minimum": 0, "maximum": 3000 },
          "manualQuietMs": { "type": "int64", "minimum": 0, "maximum": 600000 }
        }
      },
      "BlobParams": {
        "type": "object",
        "fields": {
          "endpoint": { "type": "string", "minLength": 1, "maxLength": 512 },
          "token": { "type": "string", "minLength": 1, "maxLength": 512 },
          "maxBytes": { "type": "int64", "minimum": 1, "maximum": 20971520 }
        }
      },
      "WelcomeBody": {
        "type": "object",
        "fields": {
          "session": { "type": "string", "minLength": 1, "maxLength": 128 },
          "proto": { "type": "int", "minimum": 1 },
          "hb": { "ref": "HbParams" },
          "limits": { "ref": "Limits" },
          "contractMatch": { "type": "boolean" },
          "now": { "type": "int64", "minimum": 0 },
          "sensors": { "ref": "SensorParams", "optional": true },
          "blob": { "ref": "BlobParams", "optional": true }
        }
      },
      "ByeBody": {
        "type": "object",
        "fields": {
          "code": { "type": "string", "enumRef": "byeCodes" },
          "message": { "type": "string", "optional": true, "maxLength": 500, "maxBytes": 2000 }
        }
      },
      "CmdContext": {
        "type": "object",
        "fields": {
          "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
          "accountRef": { "type": "string", "minLength": 1, "maxLength": 256 },
          "expectedPrincipalFingerprint": { "type": "string", "optional": true, "minLength": 1, "maxLength": 256, "maxBytes": 1024 }
        }
      },
      "CmdBody": {
        "type": "object",
        "fields": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "ver": { "type": "int", "minimum": 1, "maximum": 65535 },
          "context": { "ref": "CmdContext", "optional": true },
          "args": { "type": "object", "raw": true },
          "idemKey": { "type": "string", "optional": true, "minLength": 1, "maxLength": 1024, "maxBytes": 4096 },
          "deadline": { "type": "int64", "minimum": 0 },
          "execBudgetMs": { "type": "int64", "minimum": 1, "maximum": 240000 },
          "leaseMs": { "type": "int64", "optional": true, "minimum": 5000, "maximum": 120000 },
          "guards": { "type": "object", "raw": true, "optional": true }
        }
      },
      "Evidence": {
        "type": "object",
        "fields": {
          "type": { "type": "string", "minLength": 1, "maxLength": 128 },
          "text": { "type": "string", "optional": true, "maxBytes": 2048 },
          "blob": { "type": "string", "optional": true, "minLength": 1, "maxLength": 128 }
        }
      },
      "ErrorBody": {
        "type": "object",
        "fields": {
          "code": { "type": "string", "enumRef": "errorCodes" },
          "message": { "type": "string", "optional": true, "maxLength": 500, "maxBytes": 2000 },
          "retryable": { "type": "string", "enumRef": "enums.retryable", "optional": true },
          "sideEffect": { "type": "string", "enumRef": "enums.sideEffect", "optional": true },
          "data": { "type": "object", "raw": true, "optional": true, "maxJsonBytes": 65536 },
          "evidence": { "type": "array", "optional": true, "maxItems": 4, "items": { "ref": "Evidence" } }
        }
      },
      "AckBody": {
        "type": "object",
        "fields": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "type": "string", "enumRef": "enums.ackStatus" },
          "error": { "ref": "ErrorBody", "optional": true, "nullable": true }
        },
        "rules": [
          { "kind": "requiredWhen", "field": "error", "whenField": "status", "equals": ["rejected"] },
          { "kind": "forbiddenWhen", "field": "error", "whenField": "status", "equals": ["accepted", "duplicate"] }
        ]
      },
      "ResultBody": {
        "type": "object",
        "fields": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "status": { "type": "string", "enumRef": "enums.resultStatus" },
          "data": { "type": "any", "optional": true, "nullable": true, "maxJsonBytes": 65536 },
          "dataBlobRef": { "type": "string", "optional": true, "nullable": true, "minLength": 1, "maxLength": 128 },
          "error": { "ref": "ErrorBody", "optional": true, "nullable": true },
          "evidence": { "type": "array", "optional": true, "maxItems": 4, "items": { "ref": "Evidence" } },
          "replayed": { "type": "boolean" },
          "execMs": { "type": "int64", "minimum": 0, "maximum": 240000 }
        },
        "rules": [
          { "kind": "exactlyOneWhen", "fields": ["data", "dataBlobRef"], "whenField": "status", "equals": ["ok"] },
          { "kind": "requiredWhen", "field": "error", "whenField": "status", "equals": ["failed"] },
          { "kind": "forbiddenWhen", "field": "error", "whenField": "status", "equals": ["ok", "canceled", "expired"] },
          { "kind": "forbiddenWhen", "field": "data", "whenField": "status", "equals": ["failed", "canceled", "expired"] },
          { "kind": "forbiddenWhen", "field": "dataBlobRef", "whenField": "status", "equals": ["failed", "canceled", "expired"] }
        ]
      },
      "PingContext": {
        "type": "object",
        "fields": {
          "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
          "accountRef": { "type": "string", "minLength": 1, "maxLength": 256 },
          "ready": { "type": "boolean" },
          "reason": { "type": "string", "enumRef": "enums.notReadyReason", "optional": true }
        },
        "rules": [
          { "kind": "requiredWhen", "field": "reason", "whenField": "ready", "equals": [false] },
          { "kind": "forbiddenWhen", "field": "reason", "whenField": "ready", "equals": [true] }
        ]
      },
      "SensorReading": {
        "type": "object",
        "fields": {
          "value": { "type": "int", "minimum": 0, "maximum": 1000000 },
          "observedAgoMs": { "type": "int64", "minimum": 0, "maximum": 86400000 }
        }
      },
      "PingSensors": {
        "type": "object",
        "fields": {
          "unreadTotal": { "ref": "SensorReading", "nullable": true }
        }
      },
      "PingBody": {
        "type": "object",
        "fields": {
          "queueDepth": { "type": "int", "minimum": 0, "maximum": 16 },
          "inFlight": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 128 },
          "contexts": { "type": "array", "optional": true, "maxItems": 64, "items": { "ref": "PingContext" } },
          "sensors": { "ref": "PingSensors", "optional": true, "nullable": true }
        }
      },
      "PongBody": {
        "type": "object",
        "fields": {
          "now": { "type": "int64", "minimum": 0 }
        }
      },
      "ProgressBody": {
        "type": "object",
        "fields": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "stage": { "type": "string", "minLength": 1, "maxLength": 200, "maxBytes": 800 },
          "pct": { "type": "int", "optional": true, "minimum": 0, "maximum": 100 }
        }
      },
      "EventContext": {
        "type": "object",
        "fields": {
          "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
          "accountRef": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      },
      "EventBody": {
        "type": "object",
        "fields": {
          "name": { "type": "string", "enumRef": "events" },
          "context": { "ref": "EventContext" },
          "observedAt": { "type": "int64", "minimum": 0 },
          "data": { "type": "object", "raw": true }
        }
      },
      "QueryBody": {
        "type": "object",
        "fields": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "JournalSnapshot": { "type": "object", "fields": {} },
      "ReportBody": {
        "type": "object",
        "fields": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "state": { "type": "string", "enumRef": "enums.reportState" },
          "result": { "ref": "ResultBody", "nullable": true },
          "journal": { "ref": "JournalSnapshot", "nullable": true }
        }
      },
      "CancelBody": {
        "type": "object",
        "fields": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reason": { "type": "string", "enumRef": "enums.cancelReason" }
        }
      },

      "DebugPingArgs": {
        "type": "object",
        "fields": { "echo": { "type": "any", "optional": true } }
      },
      "DebugPingData": {
        "type": "object",
        "fields": {
          "echo": { "type": "any" },
          "swStartedAt": { "type": "int64", "minimum": 0 }
        }
      },
      "DebugSwitchWindowArgs": { "type": "object", "fields": {} },
      "DebugSwitchWindowData": {
        "type": "object",
        "fields": { "switched": { "type": "boolean" } }
      },
      "DebugSlowEchoArgs": {
        "type": "object",
        "fields": {
          "ms": { "type": "int", "minimum": 0, "maximum": 200000 },
          "outcome": { "type": "string", "enumRef": "enums.debugSlowOutcome" }
        }
      },
      "DebugSlowEchoData": {
        "type": "object",
        "fields": { "echoedAfterMs": { "type": "int", "minimum": 0, "maximum": 200000 } }
      },
      "ProbePlatformArgs": { "type": "object", "fields": {} },
      "PlatformSurface": {
        "type": "object",
        "fields": { "imListVisible": { "type": "boolean" } }
      },
      "ProbePlatformData": {
        "type": "object",
        "fields": {
          "pageKind": { "type": "string", "enumRef": "enums.pageKind" },
          "contentScriptOk": { "type": "boolean" },
          "loginState": { "type": "string", "enumRef": "enums.loginState" },
          "principalFingerprint": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 256, "maxBytes": 1024 },
          "surface": { "ref": "PlatformSurface", "nullable": true }
        }
      },
      "NavEnsureSurfaceArgs": {
        "type": "object",
        "fields": { "surface": { "type": "string", "enumRef": "enums.surfaceName" } }
      },
      "NavEnsureSurfaceData": {
        "type": "object",
        "fields": {
          "ready": { "type": "boolean" },
          "loginState": { "type": "string", "enumRef": "enums.loginState" },
          "createdTab": { "type": "boolean" }
        }
      },
      "PeerSummary": {
        "type": "object",
        "fields": {
          "displayName": { "type": "string", "minLength": 1, "maxLength": 256, "maxBytes": 1024 },
          "platformUserRef": { "type": "string", "optional": true, "minLength": 1, "maxLength": 512, "maxBytes": 2048 }
        }
      },
      "LastMessageSummary": {
        "type": "object",
        "fields": {
          "direction": { "type": "string", "enumRef": "enums.messageDirection" },
          "kind": { "type": "string", "enumRef": "enums.messageKind" },
          "textPreview": { "type": "string", "maxLength": 200, "maxBytes": 800 }
        }
      },
      "ConversationSummary": {
        "type": "object",
        "fields": {
          "conversationRef": { "type": "string", "minLength": 1, "maxLength": 512, "maxBytes": 2048 },
          "peer": { "ref": "PeerSummary" },
          "unreadCount": { "type": "int", "minimum": 0, "maximum": 1000000 },
          "lastMessage": { "ref": "LastMessageSummary" },
          "lastActivityTs": { "type": "int64", "nullable": true, "minimum": 0 }
        }
      },
      "ChatReadListArgs": {
        "type": "object",
        "fields": {
          "filter": { "type": "string", "enumRef": "enums.listFilter" },
          "stopOlderThanDays": { "type": "int", "optional": true, "default": 8, "minimum": 1, "maximum": 30 },
          "maxSessions": { "type": "int", "optional": true, "default": 32, "minimum": 1, "maximum": 32 },
          "cursor": { "type": "string", "optional": true, "minLength": 1, "maxLength": 512, "maxBytes": 2048 }
        }
      },
      "ChatReadListData": {
        "type": "object",
        "maxJsonBytes": 65536,
        "fields": {
          "sessions": { "type": "array", "maxItems": 32, "items": { "ref": "ConversationSummary" } },
          "complete": { "type": "boolean" },
          "nextCursor": { "type": "string", "optional": true, "nullable": true, "minLength": 1, "maxLength": 512, "maxBytes": 2048 }
        },
        "rules": [
          { "kind": "requiredWhen", "field": "nextCursor", "whenField": "complete", "equals": [false] },
          { "kind": "forbiddenWhen", "field": "nextCursor", "whenField": "complete", "equals": [true] }
        ]
      },
      "MessageAnchor": {
        "type": "object",
        "fields": {
          "direction": { "type": "string", "enumRef": "enums.messageDirection" },
          "contentHash": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      },
      "ThreadWindow": {
        "type": "object",
        "fields": {
          "maxMessages": { "type": "int", "optional": true, "default": 50, "minimum": 1, "maximum": 64 },
          "anchorTail": { "type": "array", "optional": true, "maxItems": 5, "items": { "ref": "MessageAnchor" } },
          "deep": { "type": "boolean", "optional": true, "default": false }
        }
      },
      "ChatReadThreadArgs": {
        "type": "object",
        "fields": {
          "conversationRef": { "type": "string", "minLength": 1, "maxLength": 512, "maxBytes": 2048 },
          "window": { "ref": "ThreadWindow" },
          "cursor": { "type": "string", "optional": true, "minLength": 1, "maxLength": 512, "maxBytes": 2048 }
        }
      },
      "ThreadMessage": {
        "type": "object",
        "fields": {
          "idx": { "type": "int", "minimum": 0, "maximum": 63 },
          "direction": { "type": "string", "enumRef": "enums.messageDirection" },
          "kind": { "type": "string", "enumRef": "enums.messageKind" },
          "text": { "type": "string", "nullable": true, "maxBytes": 2048 },
          "blobRef": { "type": "string", "nullable": true, "minLength": 1, "maxLength": 128 },
          "contentHash": { "type": "string", "minLength": 1, "maxLength": 128 },
          "cardType": { "type": "string", "enumRef": "enums.cardType", "optional": true, "nullable": true },
          "cardState": { "type": "string", "enumRef": "enums.cardState", "optional": true, "nullable": true },
          "tsApprox": { "type": "int64", "optional": true, "nullable": true, "minimum": 0 }
        }
      },
      "ChatReadThreadData": {
        "type": "object",
        "maxJsonBytes": 65536,
        "fields": {
          "messages": { "type": "array", "maxItems": 64, "items": { "ref": "ThreadMessage" } },
          "reachedTop": { "type": "boolean" },
          "anchorMatched": { "type": "boolean" },
          "peer": { "ref": "PeerSummary", "nullable": true },
          "complete": { "type": "boolean" },
          "nextCursor": { "type": "string", "optional": true, "nullable": true, "minLength": 1, "maxLength": 512, "maxBytes": 2048 }
        },
        "rules": [
          { "kind": "requiredWhen", "field": "nextCursor", "whenField": "complete", "equals": [false] },
          { "kind": "forbiddenWhen", "field": "nextCursor", "whenField": "complete", "equals": [true] },
          { "kind": "atLeastOneTrueWhen", "fields": ["reachedTop", "anchorMatched"], "whenField": "complete", "equals": [true] },
          { "kind": "allFalseWhen", "fields": ["reachedTop", "anchorMatched"], "whenField": "complete", "equals": [false] }
        ]
      },

      "UnreadBadgeEventData": {
        "type": "object",
        "fields": {
          "scope": { "type": "string", "enumRef": "enums.unreadScope" },
          "value": { "type": "int", "minimum": 0, "maximum": 1000000 },
          "prev": { "type": "int", "nullable": true, "minimum": 0, "maximum": 1000000 },
          "stable": { "type": "boolean", "const": true }
        }
      },
      "PageNavigatedEventData": {
        "type": "object",
        "fields": {
          "pageKind": { "type": "string", "enumRef": "enums.pageKind" },
          "at": { "type": "int64", "minimum": 0 }
        }
      },
      "LoginStateChangedEventData": {
        "type": "object",
        "fields": {
          "state": { "type": "string", "enumRef": "enums.loginChangeState" },
          "stable": { "type": "boolean", "const": true },
          "at": { "type": "int64", "minimum": 0 }
        }
      },
      "ManualInteractionEventData": {
        "type": "object",
        "fields": {
          "kind": { "type": "string", "enumRef": "enums.manualInteractionKind" },
          "pageKind": { "type": "string", "enumRef": "enums.pageKind" },
          "at": { "type": "int64", "minimum": 0 }
        }
      }
    }
  },
  "classes": {
    "readonly":  { "redispatch": "free(封顶 2)", "serialDomain": false, "idemKey": "forbidden", "evidence": "none" },
